# Exchange Configuration
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
EXCHANGE_SANDBOX=true

# Trading Mode (CRITICAL: default is dry-run)
TRADING_MODE=dry_run
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_TOKEN=

# TradingView Webhook
TV_WEBHOOK_SECRET=your_webhook_secret_here
TV_WEBHOOK_PORT=8000

# Phase 2: Alert Execution Configuration
ALERT_MAX_AGE_SECONDS=600
MIN_CONFIDENCE=0.9
ALLOWED_SYMBOLS=BTC/USDT:USDT
ALLOWED_TIMEFRAMES=5m
EXECUTION_ENABLED=true

# Bot Integration
BOT_TYPE=freqtrade
FREQTRADE_API_URL=http://bot:8080
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=

# Dashboard
DASHBOARD_PORT=3000

# Multi-Pair Settings
ENABLED_PAIRS=BTC/USDT:USDT,ETH/USDT:USDT
MAX_OPEN_TRADES=3
DEFAULT_TIMEFRAME=5m

# AI Advisor (advisory only - never places orders)
OPENAI_API_KEY=
AI_ADVISOR_ENABLED=true
AI_TECHNICAL_WEIGHT=0.4
AI_REGIME_WEIGHT=0.3
AI_SENTIMENT_WEIGHT=0.3

# Sentiment Analysis
SENTIMENT_LOOKBACK_HOURS=24
SENTIMENT_UPDATE_INTERVAL_MINUTES=60

# Opportunities Scorer
OPPORTUNITIES_MIN_CONFIDENCE=0.3
OPPORTUNITIES_MAX_RESULTS=10

# Risk Parameters
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_DRAWDOWN=0.025
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=30

# Backtesting Parameters
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-12-31
OPTIMIZATION_EPOCHS=100
WALKFORWARD_WINDOW_DAYS=90
WALKFORWARD_VALIDATION_DAYS=30

# Performance Thresholds
MIN_WIN_RATE=0.54
MIN_PROFIT_FACTOR=1.25
MAX_DRAWDOWN_PERCENT=12.0
MIN_TRADES_PER_PERIOD=30

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Database
DATABASE_URL=sqlite:///./alerts.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
