# Exchange Configuration
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
EXCHANGE_SANDBOX=true

# Trading Mode (CRITICAL: default is dry-run)
TRADING_MODE=dry_run
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_TOKEN=
RUNMODE=dry-run
CONFIRM_LIVE_TRADING=

# TradingView Webhook
TV_WEBHOOK_SECRET=your_webhook_secret_here
TV_WEBHOOK_PORT=8000

# Phase 2: Alert Execution Configuration
ALERT_MAX_AGE_SECONDS=600
MIN_CONFIDENCE=0.9
ALLOWED_SYMBOLS=BTC/USDT:USDT
ALLOWED_TIMEFRAMES=5m
EXECUTION_ENABLED=true

# Phase 2.1: Security & Authentication
# HMAC signature authentication (optional, backward compatible)
REQUIRE_HMAC=false
HMAC_SKEW_SECONDS=60
NONCE_TTL_SECONDS=600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
MAX_PAYLOAD_SIZE_KB=32

# Operational Safety Switches
WEBHOOK_ACCEPTING_ENABLED=true
# When RUNMODE is not dry-run, you MUST set CONFIRM_LIVE_TRADING=YES
# This prevents accidental live trading
# CONFIRM_LIVE_TRADING=YES

# Circuit Breaker (Bot Integration Resilience)
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=300
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# IP Filtering (CIDR notation, comma-separated)
# Leave empty to allow all IPs
IP_ALLOWLIST=
IP_DENYLIST=
# Only trust X-Forwarded-For from these proxy IPs
TRUSTED_PROXY_CIDRS=

# Admin Endpoints (leave empty to disable)
ADMIN_TOKEN=

# Bot Integration
BOT_TYPE=freqtrade
FREQTRADE_API_URL=http://bot:8080
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=

# Dashboard
DASHBOARD_PORT=3000

# Multi-Pair Settings
ENABLED_PAIRS=BTC/USDT:USDT,ETH/USDT:USDT
MAX_OPEN_TRADES=3
DEFAULT_TIMEFRAME=5m

# AI Advisor (advisory only - never places orders)
OPENAI_API_KEY=
AI_ADVISOR_ENABLED=true
AI_TECHNICAL_WEIGHT=0.4
AI_REGIME_WEIGHT=0.3
AI_SENTIMENT_WEIGHT=0.3

# Sentiment Analysis
SENTIMENT_LOOKBACK_HOURS=24
SENTIMENT_UPDATE_INTERVAL_MINUTES=60

# Sentiment Spike Detection
SENTIMENT_SPIKE_THRESHOLD=0.3
SENTIMENT_SPIKE_WINDOW_MINUTES=60
SENTIMENT_SPIKE_COOLDOWN_MINUTES=30
SENTIMENT_SPIKE_ALERTS_ENABLED=true

# CryptoPanic API (Milestone 1 - Live Sentiment)
CRYPTOPANIC_API_KEY=your_key_here

# Reddit API (optional – public JSON API used by default, no credentials required)
# Set these only if you plan to use PRAW for authenticated access
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TradingBot/1.0 Sentiment Scraper

# Twitter/X API v2 (Milestone 1 - Live Sentiment)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Fear & Greed Index (no API key required — public endpoint)
# https://alternative.me/crypto/fear-and-greed-index/
FEAR_GREED_CACHE_TTL_SECONDS=3600

# Multi-Exchange Support (groundwork — Bybit and OKX disabled by default)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here

# Opportunities Scorer
OPPORTUNITIES_MIN_CONFIDENCE=0.3
OPPORTUNITIES_MAX_RESULTS=10

# Risk Parameters
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_DRAWDOWN=0.025
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=30

# Backtesting Parameters
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-12-31
OPTIMIZATION_EPOCHS=100
WALKFORWARD_WINDOW_DAYS=90
WALKFORWARD_VALIDATION_DAYS=30

# Performance Thresholds
MIN_WIN_RATE=0.54
MIN_PROFIT_FACTOR=1.25
MAX_DRAWDOWN_PERCENT=12.0
MIN_TRADES_PER_PERIOD=30

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ML Signal Enhancement (optional)
ML_MODEL_PATH=
# ML_MODEL_PATH=models/signal_classifier_latest.joblib

# Database
DATABASE_URL=sqlite:///./alerts.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
